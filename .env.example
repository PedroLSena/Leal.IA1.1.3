# ==============================================================================
# LEAL.AI SAAS — AMBIENTE E SEGURANÇA
# ==============================================================================

# Configuração do Servidor
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Configuração do PostgreSQL
DATABASE_URL=postgresql://leal_user:leal_password@localhost:5432/leal_db
PGHOST=localhost
PGPORT=5432
PGUSER=leal_user
PGPASSWORD=leal_password
PGDATABASE=leal_db
PGSSL=false

# Autenticação JWT
# ATENÇÃO: Em produção, utilize uma chave aleatória criptográfica de no mínimo 64 bytes
JWT_SECRET=leal_ai_jwt_access_secret_super_secure_key_2026_change_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=leal_ai_jwt_refresh_secret_ultra_secure_rotation_2026
JWT_REFRESH_EXPIRES_IN=7d

# Segurança e CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:3001

# Frontend (Vercel/produção)
# Defina a URL do backend em produção, por exemplo:
# VITE_API_BASE_URL=https://sua-api.vercel.app/api
VITE_API_BASE_URL=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5

# Modo de Armazenamento Resiliente de Desenvolvimento
# Se true e PostgreSQL não estiver disponível, ativa o storage inteligente em memória/arquivo com prepared statements
ENABLE_DEV_FALLBACK_STORE=true
